    "planet.delete.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This also deletes the networks and moons saved under this planet. If the tunnel is using it, the VPN will stop and fall back to the official planet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将一并删除该行星下保存的网络和卫星。若隧道正在使用它，VPN 将停止并回退到官方行星。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將一併刪除此行星下保存的網路和衛星。若隧道正在使用它，VPN 將停止並回退至官方行星。"
