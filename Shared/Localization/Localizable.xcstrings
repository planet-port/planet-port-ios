    "prefs.ondemand.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, the VPN stays persistently connected, which increases your phone's power usage. Turn it off when not in use to save battery."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后 VPN 将保持持久在线，这将增加手机的耗电。不用时请及时关闭连接以节省能耗。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後 VPN 將保持持久在線，這將增加手機的耗電。不用時請及時關閉連線以節省能耗。"
          }
        }
