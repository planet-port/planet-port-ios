    "prefs.theme.footer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The accent color drives buttons, indicators and planet decorations, adapting to light and dark mode; status colors keep green/orange/red semantics by default — enable the switch to derive the success color from the accent."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主色决定按钮、指示器与行星装饰色，深浅模式自动适配；状态色默认保持绿/橙/红语义，打开开关后成功色随主色三角派生。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主色決定按鈕、指示器與行星裝飾色，深淺模式自動適配；狀態色預設保持綠/橙/紅語義，打開開關後成功色隨主色三角派生。"
          }
        }
      }
    },
